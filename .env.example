# Client Portal — copy to .env.local for `vercel dev`, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables. Never commit real values.
# These are server-only: none is prefixed VITE_, so none ships to the browser.

# Supabase -> Project settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Bypasses row level security. Server only; never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Project settings -> API -> JWT Settings -> JWT Secret (the legacy HS256 secret).
# Session cookies are signed with it so Postgres row level security can trust them.
SUPABASE_JWT_SECRET=

# Stripe -> Developers -> API keys / Webhooks
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ids for the three offers, so Stripe prices can change without code changes
# $30 / month, 10 edits
STRIPE_PRICE_RETAINER=price_...
# $50 one-time, 5 edits
STRIPE_PRICE_BATCH=price_...
# $500 one-time, self-managed
STRIPE_PRICE_HANDOVER=price_...

# Owner dashboard at /portal/admin.
# Hash of your admin password: npm run portal:hash -- "your password", then paste the hash.
ADMIN_PASSWORD_HASH=
# Any long random string (e.g. openssl rand -base64 48). Signs the admin cookie; keep it different
# from SUPABASE_JWT_SECRET.
ADMIN_SESSION_SECRET=

# Optional: set when the site is served from a different origin than the request sees
# (used for the Stripe billing-portal return link). Defaults to the request's own origin.
# PORTAL_BASE_URL=https://yourdomain.com
